{
  "name": "dravencms/admin",
  "type": "dravencms-package",
  "description": "Admin module for dravencms",
  "keywords": [
    "dravencms",
    "admin"
  ],
  "license": [
    "LGPL-3.0"
  ],
  "authors": [
    {
      "name": "Adam Schubert"
    }
  ],
  "require": {
    "php": ">=8.2",
    "dravencms/application": "^0.3",
    "dravencms/user": "^3.1",
    "symfony/cache": "^6.4 || ^7.0 || ^8.0",
    "symfony/lock": "^6.4 || ^7.0 || ^8.0",
    "symfony/rate-limiter": "^6.4 || ^7.0 || ^8.0"
  },
  "autoload": {
    "psr-0": {
      "Dravencms\\": "src/"
    }
  },
  "extra": {
    "dravencms": {
      "files": {
        "assets/*": "%wwwDir%/assets/admin"
      },
      "configuration": "dravencms.config.neon"
    }
  },
  "conflict": {
    "dravencms/api": "<0.7.0",
    "dravencms/article": "<2.8.0",
    "dravencms/carousel": "<2.5.0",
    "dravencms/cookie-consent": "<1.10.0",
    "dravencms/file": "<2.8.0",
    "dravencms/file-download": "<2.6.0",
    "dravencms/form": "<2.7.0",
    "dravencms/gallery": "<2.7.0",
    "dravencms/locale": "<2.8.0",
    "dravencms/location": "<1.8.0",
    "dravencms/map": "<2.5.0",
    "dravencms/partner": "<2.6.0",
    "dravencms/seo": "<3.8.0",
    "dravencms/structure": "<2.8.0",
    "dravencms/tag": "<2.6.0"
  }
}
