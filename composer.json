{
  "name": "dravencms/admin",
  "type": "dravencms-package",
  "description": "Admin module for dravencms",
  "keywords": [
    "dravencms",
    "admin"
  ],
  "license": [
    "LGPL-3.0"
  ],
  "authors": [
    {
      "name": "Adam Schubert"
    }
  ],
  "require": {
    "php": ">=8.2",
    "dravencms/application": ">=0.0.3",
    "dravencms/user": "^3.0"
  },
  "autoload": {
    "psr-0": {
      "Dravencms\\": "src/"
    }
  },
  "extra": {
    "dravencms": {
      "files": {
        "assets/*": "%wwwDir%/assets/admin"
      },
      "configuration": "dravencms.config.neon"
    }
  },
  "conflict": {
    "dravencms/api": "<0.4.0",
    "dravencms/article": "<2.6.0",
    "dravencms/carousel": "<2.3.0",
    "dravencms/cookie-consent": "<1.8.0",
    "dravencms/file": "<2.6.0",
    "dravencms/file-download": "<2.4.0",
    "dravencms/form": "<2.5.0",
    "dravencms/gallery": "<2.4.0",
    "dravencms/locale": "<2.5.0",
    "dravencms/location": "<1.5.0",
    "dravencms/map": "<2.3.0",
    "dravencms/partner": "<2.4.0",
    "dravencms/seo": "<3.5.0",
    "dravencms/structure": "<2.6.0",
    "dravencms/tag": "<2.4.0"
  }
}
