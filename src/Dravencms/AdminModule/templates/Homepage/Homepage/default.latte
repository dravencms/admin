{block content}
    <div class="mb-4">
        <h1>{_"admin.presenter.homepage.Welcome"}!</h1>
        <p class="text-secondary">{_"admin.presenter.homepage.WelcomeToDravenCMSaContentManagementSystem"}.</p>
    </div>
    <div class="row g-3">
        {foreach $dashboardPanels as $name => $definition}
            <div class="col-12 col-xl-6">
                <section class="card h-100" data-dashboard-panel="{$definition->id}">
                    <div class="card-header">
                        <h2 class="card-title">
                            <i class="fa {$definition->icon} me-2" aria-hidden="true"></i>
                            {if $definition->destination}<a href="{plink $definition->destination}">{_$definition->title}</a>{else}{_$definition->title}{/if}
                        </h2>
                    </div>
                    <div class="card-body">{control "dashboard-$name"}</div>
                </section>
            </div>
        {/foreach}
    </div>
{/block}
