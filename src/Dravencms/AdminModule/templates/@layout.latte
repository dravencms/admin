<!doctype html>
<html lang="{$lang}" data-bs-navbar-position="combined">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{ifset $h1}{$h1} | {/ifset}DravenCMS</title>
    <link rel="icon" href="{$basePath}/assets/admin/img/favicon.ico">
    {control css}
</head>
<body>
<div class="page">
    <aside class="navbar navbar-vertical navbar-expand-lg admin-sidebar" aria-label="Administration">
        <div class="container-fluid">
            <a n:href=":Admin:Homepage:Homepage:" class="navbar-brand">
                <img src="{$basePath}/assets/admin/img/favicon.ico" alt=""> DravenCMS
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#admin-navigation" aria-controls="admin-navigation" aria-expanded="false" aria-label="Menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="admin-navigation">
                {control menu}
            </div>
        </div>
    </aside>
    <header class="navbar navbar-expand-md d-print-none">
        <div class="container-fluid">
            <div class="navbar-nav flex-row ms-auto align-items-center gap-3">
                {control menuNotification}
                <div class="nav-item dropdown">
                    <a href="#" class="nav-link d-flex align-items-center gap-2" data-bs-toggle="dropdown" aria-expanded="false">
                        <img class="avatar avatar-sm" src="{$gravatar}" alt="">
                        <span>{$userInfo->getFirstName()} {$userInfo->getLastName()}</span>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end">
                        <a n:href=":Admin:User:Account:" class="dropdown-item"><i class="fa fa-user me-2"></i>{_"admin.layout.MyProfile"}</a>
                        <a n:href=":Admin:User:Sign:out" class="dropdown-item"><i class="fa fa-power-off me-2"></i>{_"admin.layout.LogOut"}</a>
                    </div>
                </div>
            </div>
        </div>
    </header>
    <div class="page-wrapper">
        <div class="page-header d-print-none">
            <div class="container-fluid">
                {control menuBreadcrumb}
                <h1 class="page-title" n:ifset="$h1">{$h1}</h1>
            </div>
        </div>
        <main class="page-body" id="content-wrapper">
            <div class="container-fluid">
                <div n:foreach="$flashes as $flash" class="alert {$flash->type}" role="alert">{$flash->message|noescape}</div>
                {include content}
            </div>
        </main>
    </div>
</div>
{control js}
{ifset js}{include js}{/ifset}
{include 'global.latte'}
</body>
</html>
