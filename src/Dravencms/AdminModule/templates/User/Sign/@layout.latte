{var $name = 'DravenCMS'}
<!doctype html>
<html lang="{$lang}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <title>{block title}DravenCMS{/block}</title>
    <link rel="icon" href="{$basePath}/assets/admin/img/favicon.ico">
    {control css}
</head>
<body>
    <main class="admin-auth">
        <a n:href=":Admin:Homepage:Homepage:default" class="admin-auth-brand">
            <img src="{$basePath}/assets/admin/img/favicon.ico" alt=""> DravenCMS
        </a>
        <div n:foreach="$flashes as $flash" class="alert {$flash->type}" role="alert">{$flash->message|noescape}</div>
        {include content}
    </main>
    {control js}
</body>
</html>
