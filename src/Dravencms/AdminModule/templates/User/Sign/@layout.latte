{var $name = 'DravenCMS'}
<!doctype html>
<html lang="{$presenter->translator->getLocale()}">
<head>
    <meta charset="utf-8">
    <meta name="admin-mutation-token" content="{$presenter->getAdminMutationToken()}">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <title>{block title}DravenCMS{/block}</title>
    <link rel="icon" href="{$basePath}/assets/admin/img/favicon.ico">
    {include '../../theme-init.latte'}
    {control css}
</head>
<body>
    <main class="admin-auth">
        <div class="d-flex justify-content-end align-items-center gap-3 mb-3">
            {include '../../language-switcher.latte'}
            {include '../../theme-switcher.latte'}
        </div>
        <a n:href=":Admin:Homepage:Homepage:default" class="admin-auth-brand">
            <img src="{$basePath}/assets/admin/img/favicon.ico" alt=""> DravenCMS
        </a>
        <div n:foreach="$flashes as $flash" class="alert {$flash->type}" role="alert">{$flash->message|noescape}</div>
        {include content}
    </main>
    {include '../../translations.latte'}
    {control js}
</body>
</html>
