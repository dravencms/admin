{* Latte template *}

{block content}
    <ul class="nav nav-tabs">
        <li class="nav-item"><a class="nav-link active" href="#home" data-bs-toggle="tab">{_'admin.account.basicInformation'}</a></li>
        <li class="nav-item"><a class="nav-link" href="#password-change" data-bs-toggle="tab">{_'admin.account.changePassword'}</a></li>
        <li class="nav-item"><a class="nav-link" href="#avatar-change" data-bs-toggle="tab">{_'admin.account.avatar'}</a></li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="home">
            {control formAccount}
        </div>
        <div class="tab-pane fade show" id="password-change">
            {control formAccountPassword}
        </div>
        <div class="tab-pane fade show" id="avatar-change">
            <div>
                <!--img n:gravatar="$userInfo->getEmail(), 100" alt="Gravatar"/-->
                <img src="{$gravatar}" alt="Gravatar"/>
            </div>
            <p>{_'admin.account.changeAvatarAt'} <a href="https://gravatar.com/" target="_blank">https://gravatar.com/</a></p>
        </div>
    </div>
{/block}
