<div class="dropdown" data-theme-switcher>
    <button type="button" class="btn btn-icon btn-ghost-secondary" data-bs-toggle="dropdown" data-theme-toggle aria-expanded="false" title="{_'admin.theme.label'}" aria-label="{_'admin.theme.label'}">
        <i class="fa fa-desktop" data-theme-icon aria-hidden="true"></i>
    </button>
    <div class="dropdown-menu dropdown-menu-end" role="menu" aria-label="{_'admin.theme.label'}">
        <button type="button" class="dropdown-item" data-theme-value="system" role="menuitemradio" aria-checked="true">
            <i class="fa fa-desktop me-2" aria-hidden="true"></i>{_'admin.theme.system'}<i class="fa fa-check ms-auto" data-theme-check aria-hidden="true"></i>
        </button>
        <button type="button" class="dropdown-item" data-theme-value="light" role="menuitemradio" aria-checked="false">
            <i class="fa fa-sun me-2" aria-hidden="true"></i>{_'admin.theme.light'}<i class="fa fa-check ms-auto d-none" data-theme-check aria-hidden="true"></i>
        </button>
        <button type="button" class="dropdown-item" data-theme-value="dark" role="menuitemradio" aria-checked="false">
            <i class="fa fa-moon me-2" aria-hidden="true"></i>{_'admin.theme.dark'}<i class="fa fa-check ms-auto d-none" data-theme-check aria-hidden="true"></i>
        </button>
    </div>
</div>
