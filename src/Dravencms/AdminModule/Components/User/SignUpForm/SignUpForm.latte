<form n:name="form" class="form-signup subject">
    <div class="signup-text">
        <span>{_'admin.auth.createAccount'}</span>
    </div>
    <ul class="alert alert-danger" n:if="$form->hasErrors()">
        <li n:foreach="$form->errors as $error">{$error}</li>
    </ul>
    <div class="row">
        <div class="col-sm-6">
            <div class="mb-3">
                <label class="form-label" n:name="firstName">{_'admin.form.firstName'}</label>
                <input type="text" n:name="firstName" autofocus="autofocus" class="form-control">
            </div>
        </div><!-- col-sm-6 -->
        <div class="col-sm-6">
            <div class="mb-3">
                <label class="form-label" n:name="lastName">{_'admin.form.lastName'}</label>
                <input type="text" n:name="lastName" class="form-control">
            </div>
        </div><!-- col-sm-6 -->
    </div><!-- row -->

    <div class="row">
        <div class="col-sm-6">
            <div class="mb-3">
                <label class="form-label" n:name="email">{_'admin.form.email'}</label>
                <input type="email" n:name="email" class="form-control">
            </div>
        </div><!-- col-sm-6 -->
    </div><!-- row -->


    <div class="row">
        <div class="col-sm-6">
            <div class="mb-3">
                <label class="form-label" n:name="password">{_'admin.form.password'}</label>
                <input n:name="password" class="form-control random-password">
            </div>
        </div><!-- col-sm-6 -->
        <div class="col-sm-6">
            <div class="mb-3">
                <label class="form-label" n:name="passwordAgain">{_'admin.form.passwordAgain'}</label>
                <input n:name="passwordAgain" class="form-control random-password-again">
            </div>
        </div><!-- col-sm-6 -->
    </div><!-- row -->

    <div class="row">
        <div class="col-sm-12">
            <div class="mb-3">
                <label class="form-label" n:name="captcha">{_'admin.form.antispam'} <sup>*</sup></label>
                <div n:name="captcha"></div>
            </div>
        </div><!-- col-sm-12 -->
    </div><!-- row -->

    <div class="form-actions">
        <input n:name="send" class="btn btn-success">
    </div>
</form>
