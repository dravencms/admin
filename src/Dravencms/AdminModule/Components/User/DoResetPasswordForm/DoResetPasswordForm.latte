<form n:name=form>
    <div class="signin-text">
        <span>{_'admin.auth.resetPasswordTitle'}</span>
    </div>
    <ul class="alert alert-danger" n:if="$form->hasErrors()">
        <li n:foreach="$form->errors as $error">{$error}</li>
    </ul>
    <div class="mb-3 w-icon">
        <input n:name="password" autofocus="autofocus" placeholder="{_'admin.form.password'}" class="form-control form-control-lg">
        <span class="fa fa-lock signin-form-icon"></span>
    </div>
    <div class="mb-3 w-icon">
        <input n:name="passwordAgain" placeholder="{_'admin.form.passwordAgain'}" class="form-control form-control-lg">
        <span class="fa fa-lock signin-form-icon"></span>
    </div>

    <div class="form-actions">
        <input n:name="send" class="signin-btn bg-primary">
    </div>
</form>