<form n:name="form">
    <h1 class="h2 text-center mb-4">Přihlášení</h1>
    <ul class="alert alert-danger" n:if="$form->hasErrors()">
        <li n:foreach="$form->errors as $error">{$error}</li>
    </ul>
    <div class="mb-3">
        <label n:name="email" class="form-label">Email</label>
        <input n:name="email" autofocus autocomplete="username" class="form-control">
    </div>
    <div class="mb-3">
        <label n:name="password" class="form-label">Heslo</label>
        <input n:name="password" autocomplete="current-password" class="form-control">
    </div>
    <label class="form-check mb-4">
        <input n:name="remember" class="form-check-input">
        <span class="form-check-label">Neodhlašovat</span>
    </label>
    <input n:name="sign" class="btn btn-primary w-100" value="Přihlásit">
    <div class="text-center mt-3"><a href="#password-reset-form" id="forgot-password-link">Zapomenuté heslo?</a></div>
</form>
