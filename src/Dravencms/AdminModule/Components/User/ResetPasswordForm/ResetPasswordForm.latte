<form n:name="form" class="form-signin">
    <ul class="alert alert-danger" n:if="$form->hasErrors()">
        <li n:foreach="$form->errors as $error">{$error}</li>
    </ul>
    <div class="mb-3">
        <input n:name="email" autofocus="autofocus" placeholder="{_'admin.form.email'}" class="form-control form-control-lg">
    </div>

    <div class="form-actions">
        <input n:name="send" class="btn btn-lg btn-success w-100">
    </div>
</form>
