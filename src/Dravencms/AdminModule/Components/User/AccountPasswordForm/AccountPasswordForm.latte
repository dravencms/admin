<form n:name="form" class="card  subject">
    <ul class="alert alert-danger" n:if="$form->hasErrors()">
        <li n:foreach="$form->errors as $error">{$error}</li>
    </ul>
    <div class="card-header">
        <span class="card-title">Změna hesla</span>
    </div>

    <div class="card-body">
        <div class="mb-3">
            <label class="col-sm-2 form-label" n:name="oldPassword">Staré heslo</label>
            <div class="col-sm-10">
                <input class="form-control" placeholder="Staré heslo" n:name="oldPassword">
            </div>
        </div>

        <div class="mb-3">
            <label class="col-sm-2 form-label" n:name="newPassword">Nové heslo</label>
            <div class="col-sm-10">
                <input class="form-control" placeholder="Nové heslo" n:name="newPassword">
            </div>
        </div>

        <div class="mb-3">
            <label class="col-sm-2 form-label" n:name="newPasswordAgain">Nové heslo znovu</label>
            <div class="col-sm-10">
                <input class="form-control" placeholder="Nové heslo znovu" n:name="newPasswordAgain">
            </div>
        </div>
    </div>

    <div class="card-footer">
        <input type="submit" n:name="send" class="btn btn-success button" value="Uložit">
    </div>
</form>