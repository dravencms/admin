<form n:name="form" class="card  subject">
    <ul class="alert alert-danger" n:if="$form->hasErrors()">
        <li n:foreach="$form->errors as $error">{$error}</li>
    </ul>
    <div class="card-header">
        <span class="card-title">{_'admin.account.changePassword'}</span>
    </div>

    <div class="card-body">
        <div class="mb-3">
            <label class="col-sm-2 form-label" n:name="oldPassword">{_'admin.form.oldPassword'}</label>
            <div class="col-sm-10">
                <input class="form-control" placeholder="{_'admin.form.oldPassword'}" n:name="oldPassword">
            </div>
        </div>

        <div class="mb-3">
            <label class="col-sm-2 form-label" n:name="newPassword">{_'admin.form.newPassword'}</label>
            <div class="col-sm-10">
                <input class="form-control" placeholder="{_'admin.form.newPassword'}" n:name="newPassword">
            </div>
        </div>

        <div class="mb-3">
            <label class="col-sm-2 form-label" n:name="newPasswordAgain">{_'admin.form.newPasswordAgain'}</label>
            <div class="col-sm-10">
                <input class="form-control" placeholder="{_'admin.form.newPasswordAgain'}" n:name="newPasswordAgain">
            </div>
        </div>
    </div>

    <div class="card-footer">
        <input type="submit" n:name="send" class="btn btn-success button" value="{_'admin.common.save'}">
    </div>
</form>