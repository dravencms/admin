{define dropdown}
    <div class="nav-item dropdown">
        {var $notifications = $notificationArea->getNotifications($forUser)}
        {var $count = count($notifications)}
        <a href="#" class="nav-link d-flex align-items-center gap-2" data-bs-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
            <i class="fa fa-{$notificationArea->getIcon()}"></i>
            <span class="visually-hidden">{$notificationArea->getName()}</span>
            <span class="badge bg-{$notificationArea->getCountType($count)} text-white">{$count}</span>
        </a>
        <div class="dropdown-menu dropdown-menu-end p-2" style="width: min(300px, calc(100vw - 32px))">
            <div class="navbar-notifications">
                {include $notificationArea->getNotificationTemplate(), notifications => $notifications}
            </div>

            <a n:if="$notificationArea->getMoreUrl()" href="{plink $notificationArea->getMoreUrl(), (expand)$notificationArea->getMoreUrlArguments()}" class="dropdown-item">{_$notificationArea->getMoreTitle()}</a>
        </div>
    </div>
{/define}

{foreach $notificationAreas as $notificationArea}
    {if $notificationArea->getAclResource() && $notificationArea->getAclOperation()}
        {if isAllowed($notificationArea->getAclResource(), $notificationArea->getAclOperation())}
            {include dropdown}
        {/if}
    {else}
        {include dropdown}
    {/if}
{/foreach}
