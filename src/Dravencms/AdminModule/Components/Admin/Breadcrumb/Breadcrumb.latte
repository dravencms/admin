<ol class="breadcrumb mb-2">
    <li class="breadcrumb-item"><a href="{plink ($homepage ? $homepage->destination : ':Admin:Homepage:Homepage:default'), (expand) ($homepage ? $homepage->parameters : [])}">{_'admin.component.breadcrumb.Home'}</a></li>
    <li n:foreach="$breadcrumbs as $item" n:if="$item->id !== 'admin.home'" class="breadcrumb-item{$iterator->isLast() ? ' active'}">
        {if !$iterator->isLast() && $item->destination !== null}
            <a href="{plink $item->destination, (expand) $item->parameters}">{_$item->label}</a>
        {else}
            <span aria-current="{$iterator->isLast() ? 'page' : null}">{_$item->label}</span>
        {/if}
    </li>
</ol>
