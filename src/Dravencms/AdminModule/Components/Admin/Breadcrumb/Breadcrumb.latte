<ol class="breadcrumb mb-2">
    {if $homepage}
        <li class="breadcrumb-item"><a href="{plink $homepage->getPresenter().':'.$homepage->getAction() (expand)$homepage->getParameters()}">{_"admin.component.breadcrumb.Home"}</a></li>
    {else}
        <li class="breadcrumb-item"><a href="{plink :Admin:Homepage:Homepage:}">{_"admin.component.breadcrumb.Home"}</a></li>
    {/if}

    <li n:foreach="$breadcrumbs as $breadcrumb" class="breadcrumb-item{if $thisPage == $breadcrumb} active{/if}">
        {if $thisPage == $breadcrumb}
            {$breadcrumb->getName()}
        {else}
            <a{if !$breadcrumb->getChildren()} href="{plink $breadcrumb->getPresenter().':'.$breadcrumb->getAction()}" {/if}>
                {$breadcrumb->getName()}
            </a>
        {/if}
    </li>

</ol>
